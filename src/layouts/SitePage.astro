---
import Base from './Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/site.css';
import InstallSheet from '../islands/InstallSheet';
import { fmt, getDict } from '../i18n';
import { formatSize, getLatest } from '../lib/android';
import { href, localHref } from '../lib/paths';
import AppTabBar from '../components/AppTabBar.astro';
import { flags } from '../config/flags';
import '../styles/app.css';
import type { Lang } from '../lib/paths';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  path: string;
  altPath?: string | null;
  current?: 'home' | 'guides' | 'privacy' | 'help-now' | 'app' | 'other';
  ogType?: 'website' | 'article';
  bodyClass?: string;
  noindex?: boolean;
}

const props = Astro.props;
const d = getDict(props.lang);
const native = !!import.meta.env.PUBLIC_NATIVE;
const latest = await getLatest();
const P = d.androidPage;
const android = latest
  ? {
      apkHref: href(`android/${latest.file}`),
      howToHref: localHref(props.lang, 'android/'),
      title: P.sheetTitle,
      appTitle: P.sheetAppTitle,
      appBadge: P.sheetAppBadge,
      appBody: fmt(P.sheetAppBody, { size: formatSize(latest.bytes, props.lang) }, props.lang),
      download: P.steps[0]?.title ?? d.landing.android.download,
      howTo: d.landing.android.howTo,
      webTitle: P.sheetWebTitle,
      webBody: P.sheetWebBody,
    }
  : undefined;
---

<Base {...props}>
  <slot name="head" slot="head" />
  <SiteHeader lang={props.lang} path={props.path} altPath={props.altPath} current={props.current} />
  <main id="main" tabindex="-1">
    <slot />
  </main>
  <SiteFooter lang={props.lang} />
  {flags.APP && <AppTabBar lang={props.lang} current={props.current} />}
  {
    !native && (
      <div id="install-sheet-root" class="no-print">
        <InstallSheet client:idle s={d.install} iconSrc={href('icons/icon-192.png')} android={android} />
      </div>
    )
  }
</Base>
