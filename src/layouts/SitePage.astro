---
import Base from './Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/site.css';
import InstallSheet from '../islands/InstallSheet';
import { getDict } from '../i18n';
import { href } from '../lib/paths';
import AppTabBar from '../components/AppTabBar.astro';
import { flags } from '../config/flags';
import '../styles/app.css';
import type { Lang } from '../lib/paths';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  path: string;
  altPath?: string | null;
  current?: 'home' | 'guides' | 'privacy' | 'help-now' | 'app' | 'other';
  ogType?: 'website' | 'article';
  bodyClass?: string;
  noindex?: boolean;
}

const props = Astro.props;
const d = getDict(props.lang);
---

<Base {...props}>
  <slot name="head" slot="head" />
  <SiteHeader lang={props.lang} path={props.path} altPath={props.altPath} current={props.current} />
  <main id="main" tabindex="-1">
    <slot />
  </main>
  <SiteFooter lang={props.lang} />
  {flags.APP && <AppTabBar lang={props.lang} current={props.current} />}
  <div id="install-sheet-root" class="no-print">
    <InstallSheet client:idle s={d.install} iconSrc={href('icons/icon-192.png')} />
  </div>
</Base>
