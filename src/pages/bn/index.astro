---
import Landing from '../../views/Landing.astro';
const native = import.meta.env.PUBLIC_NATIVE === '1';
---

{
  native ? (
    <html lang="bn">
      <head>
        <meta charset="utf-8" />
        <title>Dayline</title>
        <script is:inline define:vars={{ target: '/bn/app/' }}>
          location.replace(target + location.hash);
        </script>
      </head>
      <body />
    </html>
  ) : (
    <Landing lang="bn" />
  )
}
