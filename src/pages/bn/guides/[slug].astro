---
import Guide from '../../../views/Guide.astro';
import { publishedGuides, type Guide as GuideEntry } from '../../../lib/guides';

export async function getStaticPaths() {
  const guides = await publishedGuides('bn');
  return guides.map((guide) => ({ params: { slug: guide.data.slug }, props: { guide } }));
}

const { guide } = Astro.props as { guide: GuideEntry };
---

<Guide lang="bn" guide={guide} />
