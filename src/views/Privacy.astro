---
import SitePage from '../layouts/SitePage.astro';
import { getDict } from '../i18n';
import { getLatest } from '../lib/android';
import type { Lang } from '../lib/paths';
import '../styles/guides.css';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = getDict(lang);
const P = d.privacy;
const A = d.androidPage;
const latest = await getLatest();
---

<SitePage lang={lang} title={P.metaTitle} description={P.description} path="privacy/" current="privacy">
  <article class="column prose-page">
    <header class="page-head">
      <h1 class="page-title">{P.title}</h1>
      <p class="prose-page__lead">{P.lead}</p>
    </header>
    {
      P.sections.map((s) => (
        <section>
          <h2 class="t-heading-17">{s.title}</h2>
          <p class="t-body-15">{s.body}</p>
        </section>
      ))
    }
    {
      latest && (
        <section>
          <h2 class="t-heading-17">{A.privacyTitle}</h2>
          <p class="t-body-15">{A.privacyMic}</p>
          <p class="t-body-15">{A.privacySpeech}</p>
          <p class="t-body-15">{A.privacyReminders}</p>
          {latest.internet === false && <p class="t-body-15">{A.privacyNoInternet}</p>}
        </section>
      )
    }
    <p class="t-body-15">
      <a href="https://github.com/tanzir71/dayline/issues">{P.contact}</a>
    </p>
  </article>
</SitePage>
