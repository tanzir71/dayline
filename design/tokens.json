    "heading-17": { "family": "ui", "weight": 700, "size": 17, "lineHeight": 1.3 },
    "body-strong-15": { "family": "ui", "weight": 600, "size": 15, "lineHeight": 1.4 },
    "body-15": { "family": "ui", "weight": 500, "size": 15, "lineHeight": 1.4 },
    "body-strong-14": { "family": "ui", "weight": 600, "size": 14, "lineHeight": 1.4 },
    "body-14": { "family": "ui", "weight": 400, "size": 14, "lineHeight": 1.4 },
    "caption-13": { "family": "ui", "weight": 400, "size": 13, "lineHeight": 1.35 },
    "label-12": { "family": "ui", "weight": 600, "size": 12, "lineHeight": 1.3 },
    "overline-12": { "family": "ui", "weight": 700, "size": 12, "lineHeight": 1.3, "letterSpacing": "0.06em", "textTransform": "uppercase" },
