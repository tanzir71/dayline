      "food-tint": { "$value": "#F4EBD3" },
      "school": { "$value": "#6B7C80" }
    }
  },
  "font": {
    "family": {
      "display": { "$value": "'Bricolage Grotesque', system-ui, sans-serif" },
      "ui": { "$value": "'Figtree', system-ui, sans-serif" },
      "bangla": { "$value": "'Hind Siliguri', 'Noto Sans Bengali', sans-serif" }
    }
  },
  "typography": {
    "display-32": { "family": "display", "weight": 700, "size": 32, "lineHeight": 1.1, "letterSpacing": "-0.01em" },
